# 复制为 .env.local 并填值。.env.local 已被 .gitignore 覆盖，不会进仓库。
# 注意：用 PowerShell 5.1 的 Set-Content -Encoding utf8 会写入 BOM，
# 导致 Node 的 --env-file 把第一个键读成 "\uFEFFOPENAI_BASE_URL"。请用编辑器保存为 UTF-8 无 BOM。
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 数据与基线：**可选**。不填时回落到仓库内 data/contexts.jsonl.gz + data/samples.jsonl + data/baseline.jsonl
# 填了就优先用外部完整数据集（绝对路径）
DATA_DIR=
BASELINE_DIR=

# 主流程模型：必须与基线一致，否则"修复前后"对照不成立
MODEL=gpt-6-sol

# 仅推送仓库用；不需要推送时留空
GITHUB_TOKEN=
